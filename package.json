{
	"name": "@orgsdk/plugin-github",
	"version": "1.0.2",
	"description": "GitHub repository operations: issues, PRs, branches, Actions, releases",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "orgsdk-plugin validate",
		"package": "orgsdk-plugin package",
		"version-guard": "orgsdk-plugin version-guard",
		"publish": "orgsdk-plugin publish",
		"build": "bun run typecheck && bun run validate && bun run package"
	},
	"dependencies": {
		"@octokit/rest": "^22.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@orgsdk/plugins": "0.2.1",
		"@types/bun": "^1.3.9",
		"typescript": "~6.0.3"
	}
}
